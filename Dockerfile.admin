# syntax=docker/dockerfile:1.6

# ── Stage 1 — install workspace deps and build the admin SPA ─────────────
FROM node:22-bookworm-slim AS builder
RUN apt-get update \
 && apt-get install --no-install-recommends -y python3 make g++ \
 && rm -rf /var/lib/apt/lists/*
RUN corepack enable

WORKDIR /workspace

COPY package.json yarn.lock .yarnrc.yml _tsconfig.base.json ./
COPY .yarn/ ./.yarn/
COPY packages/ ./packages/
COPY app/ ./app/

RUN yarn install --network-timeout 600000 || yarn install --network-timeout 600000

# Bake the API URL into the admin bundle at build time.
ARG MEDUSA_BACKEND_URL=https://ceedmart-api-870514614467.europe-west1.run.app
ENV MEDUSA_BACKEND_URL=${MEDUSA_BACKEND_URL}
ENV DISABLE_MEDUSA_ADMIN=false
ENV NODE_OPTIONS=--max-old-space-size=4096

WORKDIR /workspace/app/ceedmart
RUN yarn build

# ── Stage 2 — nginx serving the static admin SPA ─────────────────────────
FROM nginx:alpine

COPY --from=builder /workspace/app/ceedmart/.medusa/server/public/admin/ /usr/share/nginx/html/app/

RUN cat > /etc/nginx/conf.d/default.conf << 'EOF'
server {
    listen 8080;
    server_name _;
    root /usr/share/nginx/html;
    index index.html;

    location /app {
        alias /usr/share/nginx/html/app;
        try_files $uri $uri/ /app/index.html;
    }

    location = / {
        rewrite ^ /app/ last;
    }

    location ~* \.(js|css|png|jpg|jpeg|gif|ico|svg|woff|woff2|ttf|eot)$ {
        expires 30d;
        add_header Cache-Control "public, immutable";
    }

    location /health {
        return 200 'OK';
        add_header Content-Type text/plain;
    }
}
EOF

EXPOSE 8080
CMD ["nginx", "-g", "daemon off;"]
