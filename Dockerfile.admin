# ── Stage 1 — install workspace deps and build the admin SPA ─────────────
FROM node:22-bookworm-slim AS builder
RUN apt-get update \
 && apt-get install --no-install-recommends -y python3 make g++ \
 && rm -rf /var/lib/apt/lists/*
RUN corepack enable

WORKDIR /workspace

COPY package.json yarn.lock .yarnrc.yml _tsconfig.base.json turbo.json ./
COPY .yarn/ ./.yarn/
COPY packages/ ./packages/
COPY app/ ./app/

RUN yarn install --network-timeout 600000 || yarn install --network-timeout 600000

# Bake the API URL into the admin bundle at build time.
ARG MEDUSA_BACKEND_URL=https://ceedmart-api-870514614467.europe-west1.run.app
ENV MEDUSA_BACKEND_URL=${MEDUSA_BACKEND_URL}
ENV DISABLE_MEDUSA_ADMIN=false
ENV NODE_OPTIONS=--max-old-space-size=4096

# Build all workspace packages — @medusajs/medusa re-exports every workspace
# module without declaring deps, so a filtered build misses things like
# @medusajs/rbac and TypeScript fails. See Dockerfile for full reasoning.
RUN yarn turbo run build --concurrency=100% --no-daemon

WORKDIR /workspace/app/ceedmart
RUN yarn build

# ── Stage 2 — nginx serving the static admin SPA ─────────────────────────
FROM nginx:alpine

COPY --from=builder /workspace/app/ceedmart/.medusa/server/public/admin/ /usr/share/nginx/html/app/
COPY deploy/nginx-admin.conf /etc/nginx/conf.d/default.conf

EXPOSE 8080
CMD ["nginx", "-g", "daemon off;"]
