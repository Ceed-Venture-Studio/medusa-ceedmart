# Pulse configuration — copy the block you need into .env
#
# Three Pulse services are involved, and they are separate deployments:
#
#   Identity Manager  — customers, tenants, applications, token minting
#   PaymentCore       — payments, wallets, escrow, payouts
#   Notifications     — email and SMS (unrelated to payments; leave alone)
#
# ── The rule that catches people ────────────────────────────────────────
# Identity and PaymentCore MUST point at the same environment. PaymentCore
# validates customer JWTs that Identity mints, and separate instances do not
# share signing keys. Crossing them produces an auth failure that reads like
# a bad credential, so it costs an afternoon to diagnose.
#
# ── How a payment authenticates ─────────────────────────────────────────
# Three headers reach PaymentCore, and they mean different things:
#
#   Authorization: Bearer <JWT>   the CUSTOMER's token, minted per payment via
#                                 POST {IDENTITY}/tenants/{tenant}/customers/{pimId}/token
#                                 (needs only X-API-Key — no password, and Pulse
#                                 documents this as the path for services like ours)
#   Service-Key:   <encrypted>    OUR OWN Paystack secret, encrypted by Pulse:
#                                 POST {PAYMENT}/api/v1/encrypt-key {"plainTextKey": "sk_test_…"}
#   X-API-Key:     <pulse_…>      the Identity Manager API key
#
# A customer with no pim_id cannot pay by card. That is deliberate — guests
# are not permitted to pay by card — but the storefront should say so rather
# than surfacing the provider's internal error.


# ── LOCAL ───────────────────────────────────────────────────────────────
PULSE_IDENTITY_BASE_URL=http://localhost:4048/api/v1
PULSE_PAYMENT_BASE_URL=http://localhost:5084/api/v1

# Tenant list: GET {IDENTITY}/tenants with X-API-Key (this one route accepts
# the API key; most others want an admin JWT).
PULSE_IDENTITY_TENANT_ID=

# Listing applications needs an admin JWT, so read this from the Pulse UI.
# Token minting sends it as the request body: {"applicationId": "…"}
PULSE_IDENTITY_APP_ID=

PULSE_IDENTITY_API_KEY=pulse_...
PULSE_IDENTITY_ADMIN_EMAIL=
PULSE_IDENTITY_ADMIN_PASSWORD=

PULSE_PAYMENT_API_KEY=pulse_...
PULSE_PAYMENT_CHANNEL=paystack

# POST {PAYMENT}/api/v1/encrypt-key with a Paystack TEST secret key.
# That endpoint sits behind the same JWT middleware as everything else, so
# you need a valid token before you can generate this.
PULSE_PAYMENT_SERVICE_KEY=

# Legacy: a single static service token used for every customer. Being
# replaced by per-customer tokens. The provider's validateOptions() still
# rejects an empty value, so it has to hold something until that lands.
PULSE_PAYMENT_BEARER_TOKEN=


# ── HOSTED ──────────────────────────────────────────────────────────────
# PULSE_IDENTITY_BASE_URL=https://pulse-identity-manager-218803590341.europe-west1.run.app/api/v1
# PULSE_PAYMENT_BASE_URL=https://pulse-pay-payment-enablement-service-218803590341.europe-west1.run.app/api/v1
#
# Both base URLs may be omitted entirely — the code falls back to these
# hosted defaults. Set them explicitly anyway: an unset URL silently means
# "production", which is not what you want to discover from a test charge.


# ── Switching environments ──────────────────────────────────────────────
# pim_id is issued by whichever Identity instance registered the customer,
# and is stored on our customer table. Changing PULSE_IDENTITY_BASE_URL does
# not migrate it: customers registered against one instance are unknown to
# the other and cannot pay until re-registered.
#
# Check before switching:
#   select count(*) filter (where pim_id is not null), count(*)
#   from customer where deleted_at is null;
