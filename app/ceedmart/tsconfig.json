{
  "compilerOptions": {
    "target": "ES2021",
    "module": "Node16",
    "moduleResolution": "Node16",
    "esModuleInterop": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "rootDir": ".",
    "declaration": true
  },
  "include": ["src/**/*", "medusa-config.ts"]
}
